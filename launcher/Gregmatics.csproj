<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Gregmatics.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Gregmatics</AssemblyName>
    <RootNamespace>Gregmatics</RootNamespace>
    <Product>Gregmatics</Product>
    <AssemblyTitle>Gregmatics</AssemblyTitle>
    <Description>Floor plans for a GregTech New Horizons base</Description>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
