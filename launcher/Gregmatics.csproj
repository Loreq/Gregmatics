<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Gregmatics.ico</ApplicationIcon>
    <ApplicationManifest>$(IntermediateOutputPath)app.manifest</ApplicationManifest>
    <AssemblyName>Gregmatics</AssemblyName>
    <RootNamespace>Gregmatics</RootNamespace>
    <Company>Loreq</Company>
    <Product>Gregmatics</Product>
    <AssemblyTitle>Gregmatics</AssemblyTitle>
    <Description>Floor plans for a GregTech New Horizons base</Description>
    <Version>0.1.3</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- The manifest declares PerMonitorV2. The SDK warning only wants that set in code, which Main also does. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="pack\**" />
    <EmbeddedResource Remove="pack\**" />
    <None Remove="pack\**" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="DropWpfWebView" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Identity)').Contains('WebView2.Wpf'))" />
    </ItemGroup>
  </Target>
  <Target Name="PackSite" AfterTargets="ResolvePackageAssets" BeforeTargets="PrepareResourceNames">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)pack\Pack.csproj&quot; -c Release -o &quot;$(MSBuildThisFileDirectory)pack\bin&quot;" />
    <Exec
      WorkingDirectory="$(MSBuildThisFileDirectory)"
      Command="&quot;$(MSBuildThisFileDirectory)pack\bin\Pack.exe&quot;"
      EnvironmentVariables="GREG_ROOT=$(MSBuildThisFileDirectory)..;GREG_OUT=$(MSBuildProjectDirectory)\site.zip" />
    <ItemGroup>
      <EmbeddedResource Remove="$(MSBuildProjectDirectory)\site.zip" />
      <EmbeddedResource Include="$(MSBuildProjectDirectory)\site.zip">
        <LogicalName>Gregmatics.site.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <Target Name="StampAppManifest" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)app.manifest" DestinationFiles="$(IntermediateOutputPath)app.manifest" />
    <XmlPoke
      XmlInputPath="$(IntermediateOutputPath)app.manifest"
      Query="/asm:assembly/asm:assemblyIdentity/@version"
      Namespaces="&lt;Namespace Prefix='asm' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;"
      Value="$(Version).0" />
  </Target>
</Project>
